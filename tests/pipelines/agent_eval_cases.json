{
  "description": "Coordinator knowledge agent evals. Each case is run once by scripts/record_agent_traces.py; tests/pipelines/test_agent_evals.py then checks the recorded trace, never a live run. Answer phrases are matched case-insensitively; each inner list is an any-of group and every group must match. Tool cases (AG09+) need the HealthCore API running with scripts/samples/incidents-healthcore.csv uploaded and the inventory seed loaded. tool_override points the ticket tool at a closed port (unreachable) or a server that accepts and never answers (silent).",
  "cases": [
    {
      "id": "AG01-cancellation-fee",
      "kind": "grounding",
      "question": "Is there a charge for cancelling 12 hours in advance?",
      "expected_nodes": ["receive_question", "plan_sources", "retrieve", "generate_answer"],
      "forbidden_nodes": ["no_context_answer", "reject_question", "lookup_ticket", "lookup_inventory", "tool_fallback", "compose_answer"],
      "expected_outcome": "answered",
      "expected_sources": ["knowledge_base"],
      "expected_top_source": "appointment-policy",
      "answer_must_include": [["50 USD"], ["40 GBP"], ["Medicare", "Medicaid"]],
      "answer_must_not_include": []
    },
    {
