{
  "description": "Coordinator knowledge agent evals. Each case is run once by scripts/record_agent_traces.py; tests/pipelines/test_agent_evals.py then checks the recorded trace, never a live run. Answer phrases are matched case-insensitively; each inner list is an any-of group and every group must match.",
  "cases": [
    {
      "id": "AG01-cancellation-fee",
      "kind": "grounding",
      "question": "Is there a charge for cancelling 12 hours in advance?",
      "expected_nodes": ["receive_question", "retrieve", "generate_answer"],
      "forbidden_nodes": ["no_context_answer", "reject_question"],
      "expected_outcome": "answered",
      "expected_top_source": "appointment-policy",
      "answer_must_include": [["50 USD"], ["40 GBP"], ["Medicare", "Medicaid"]],
      "answer_must_not_include": []
    },
    {
      "id": "AG02-medicare-no-show",
