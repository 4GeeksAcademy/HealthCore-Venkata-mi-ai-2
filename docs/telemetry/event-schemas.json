{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthcore.example/telemetry/event-envelope.json",
  "title": "HealthCoreTelemetryEvent",
  "description": "Envelope and property allowlists for HealthCore staff telemetry. schemaVersion 1.0.0. Matches docs/telemetry/telemetry-plan.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "timestamp",
    "sessionId",
    "userId",
    "event_type",
    "schemaVersion",
    "requestId",
    "properties"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id for this emit."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC time the fact occurred."
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "description": "X-Session-Id from the browser, or the string server when the API has no session."
    },
    "userId": {
      "type": ["string", "null"],
      "description": "TinyDB user id (JWT sub). Null when no authenticated user is known. Never an email."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "inbound_order_created",
        "outbound_order_created",
        "order_validation_failed",
        "direct_stock_edit_rejected",
        "stock_threshold_triggered",
        "product_created",
        "login_failed",
        "login_succeeded",
        "session_expired",
        "password_reset_failed",
        "password_change_failed",
        "section_viewed",
        "flow_started",
        "flow_abandoned",
        "api_latency_recorded",
        "page_load_recorded",
        "api_request_failed",
        "frontend_error_captured",
        "incident_analysis_completed",
        "supplier_record_changed",
        "web_vital_recorded"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "description": "Correlates browser, API, and logs."
    },
    "properties": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "inbound_order_created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/inboundOrderCreated" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "outbound_order_created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/outboundOrderCreated" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "order_validation_failed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/orderValidationFailed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "direct_stock_edit_rejected" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/directStockEditRejected" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "stock_threshold_triggered" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/stockThresholdTriggered" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "product_created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/productCreated" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "login_failed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "null" },
          "properties": { "$ref": "#/definitions/loginFailed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "login_succeeded" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/loginSucceeded" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "session_expired" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/sessionExpired" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "password_reset_failed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "null" },
          "properties": { "$ref": "#/definitions/passwordResetFailed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "password_change_failed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/passwordChangeFailed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "section_viewed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/sectionViewed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "flow_started" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/flowMarker" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "flow_abandoned" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/flowMarker" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "api_latency_recorded" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/apiLatencyRecorded" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "page_load_recorded" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/pageLoadRecorded" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "api_request_failed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/apiRequestFailed" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "frontend_error_captured" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/frontendErrorCaptured" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "incident_analysis_completed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/incidentAnalysisCompleted" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "web_vital_recorded" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "properties": { "$ref": "#/definitions/webVitalRecorded" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "supplier_record_changed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "properties": { "$ref": "#/definitions/supplierRecordChanged" }
        }
      }
    }
  ],
  "definitions": {
    "sectionPath": {
      "type": "string",
      "enum": [
        "/",
        "/ops",
        "/incidents",
        "/suppliers",
        "/inventory",
        "/inventory/inbound",
        "/inventory/outbound",
        "/inventory/orders",
        "/hiring",
        "/hiring/candidates/[id]",
        "/login",
        "/register",
        "/forgot-password",
        "/reset-password",
        "/account/profile",
        "/account/change-password"
      ]
    },
    "flowName": {
      "type": "string",
      "enum": ["inbound_order", "outbound_order", "register", "password_reset"]
    },
    "inboundOrderCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "product_id", "sku", "quantity"],
      "properties": {
        "order_id": { "type": "integer", "minimum": 1 },
        "product_id": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    },
    "outboundOrderCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "product_id", "sku", "quantity", "threshold_crossed"],
      "properties": {
        "order_id": { "type": "integer", "minimum": 1 },
        "product_id": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "threshold_crossed": { "type": "boolean" }
      }
    },
    "orderValidationFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "status_code", "route"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["validation_error", "duplicate_sku", "product_not_found", "insufficient_stock"]
        },
        "status_code": { "type": "integer", "enum": [400, 404, 422] },
        "route": {
          "type": "string",
          "enum": [
            "POST /inventory/products",
            "POST /inventory/orders/inbound",
            "POST /inventory/orders/outbound"
          ]
        },
        "product_id": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer" },
        "available_stock": { "type": "integer", "minimum": 0 }
      }
    },
    "directStockEditRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "rejected_fields"],
      "properties": {
        "route": { "type": "string", "const": "POST /inventory/products" },
        "rejected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["stock", "current_stock"] }
        }
      }
    },
    "stockThresholdTriggered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "product_id", "sku", "threshold", "previous_stock", "current_stock"],
      "properties": {
        "order_id": { "type": "integer", "minimum": 1 },
        "product_id": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "threshold": { "type": "integer", "minimum": 0 },
        "previous_stock": { "type": "integer", "minimum": 0 },
        "current_stock": { "type": "integer", "minimum": 0 }
      }
    },
    "productCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "sku", "threshold", "below_threshold"],
      "properties": {
        "product_id": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "threshold": { "type": "integer", "minimum": 0 },
        "below_threshold": { "type": "boolean" }
      }
    },
    "loginFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "enum": ["invalid_credentials", "inactive_user"] }
      }
    },
    "loginSucceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "enum": ["admin", "manager", "user"] }
      }
    },
    "sessionExpired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "enum": ["token_expired", "token_invalid", "token_missing"] }
      }
    },
    "passwordResetFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "const": "invalid_or_expired_token" }
      }
    },
    "passwordChangeFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "const": "current_password_incorrect" }
      }
    },
    "sectionViewed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/definitions/sectionPath" }
      }
    },
    "flowMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow"],
      "properties": {
        "flow": { "$ref": "#/definitions/flowName" }
      }
    },
    "apiLatencyRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route_template", "status_code", "duration_ms", "cache_status"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "route_template": { "type": "string", "minLength": 1 },
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "cache_status": { "type": "string", "enum": ["HIT", "MISS", "NONE"] }
      }
    },
    "pageLoadRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "duration_ms", "load_kind"],
      "properties": {
        "path": { "$ref": "#/definitions/sectionPath" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "load_kind": { "type": "string", "enum": ["navigate", "reload"] }
      }
    },
    "apiRequestFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route_template", "status_code"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "route_template": { "type": "string", "minLength": 1 },
        "status_code": { "type": "integer", "enum": [500, 503] }
      }
    },
    "frontendErrorCaptured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_name", "path"],
      "properties": {
        "error_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "$ref": "#/definitions/sectionPath" }
      }
    },
    "incidentAnalysisCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_processed", "total_valid", "total_invalid", "duration_ms"],
      "properties": {
        "total_processed": { "type": "integer", "minimum": 0 },
        "total_valid": { "type": "integer", "minimum": 0 },
        "total_invalid": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0 }
      }
    },
    "webVitalRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "path"],
      "properties": {
        "name": { "type": "string", "enum": ["LCP", "INP", "CLS", "FCP", "TTFB"] },
        "value": { "type": "number" },
        "path": { "$ref": "#/definitions/sectionPath" }
      }
    },
    "supplierRecordChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier_id", "action"],
      "properties": {
        "supplier_id": { "type": "integer", "minimum": 1 },
        "action": {
          "type": "string",
          "enum": ["created", "rate_updated", "status_updated", "deleted"]
        }
      }
    }
  }
}
